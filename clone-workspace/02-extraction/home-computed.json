  "cssVars": {
    "--theme-bg": "#0b0a0f",
    "--theme-fg": "#f4efe6",
    "--theme-accent": "#d4a24a",
    "--theme-surface": "#1e1a2a",
    "--logo-color": "#f6f3ef",
    "--hamburger-halo": "drop-shadow(0 1px 5px #0b0a0f8c)",
    "--pebble-multiply-opacity": "1",
    "--pebble-screen-opacity": "0",
    "--marquee-opacity": "0",
    "--min-h": "700px",
    "--min-h-phone": "640px",
    "--content-max": "1728px",
    "--page-w": "min(100vw,1728px)",
    "--page-x": "max(0px,calc((100vw - 1728px) / 2))",
    "--vu": "min(calc(min(100vw,1728px) / 100),calc(1.8 * max(1vh, 700px / 100)))",
    "--pu": "min(1vw,calc(.5 * max(1lvh, 640px / 100)))",
    "--vu-fit": "min(calc(min(100vw,1728px) / 100),1.8vh)",
    "--pebble-tile": "480px",
    "--leather-tile": "560px",
    "--footer-fade": ".8s",
    "--footer-desktop-height": "max(560px,min(max(100svh,700px),calc(min(100vw,1728px) * .625)))",
    "--mat": "12px",
    "--wipe-pane": "100vh",
    "--sm-plvh": "max(1lvh,calc(640px / 100))",
    "--ht-u": "1svh",
    "--home-foundation-nav-clip": "polygon(0% calc(100svh * (1 - 0 * 1.2)),100% calc(100svh * (1 - 0 * 1.8)),100% 100svh,0% 100svh)",
    "--ht-fnd-h": "max(100svh,700px,calc(min(100vw,1728px) / 1.8))",
    "--footer-comp-h": "max(560px,min(max(100svh,700px),calc(min(100vw,1728px) * .625)))",
    "--of-lvh-p": "max(1lvh,calc(640px / 100))",
    "--of-vh": "max(1vh,calc(700px / 100))",
    "--of-svh": "max(1svh,calc(700px / 100))",
    "--of-pvh": "max(1vh,calc(640px / 100))",
    "--of-psvh": "max(1svh,calc(640px / 100))",
    "--of-vw": "calc(min(100vw,1728px) / 100)"
  }
