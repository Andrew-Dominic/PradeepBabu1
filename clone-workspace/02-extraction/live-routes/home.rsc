3:["$","$Lf",null,{"featuredPartnerships":[{"_id":"partnership.under-armour","brandLogoAlt":"Under Armour","brandLogoUrl":"https://cdn.sanity.io/images/zil8k06j/production/9eeaff1c2111f7fa8797002445c619ad2aaa980e-480x304.png","category":"Fashion","description":"The signature partnership. Justin is the face of Under Armour football — custom game-day cleats, design sessions at UA headquarters in Baltimore, and a say in where the footwear goes next.","externalLink":null,"heroImageAlt":"Under Armour","heroImageUrl":"https://cdn.sanity.io/images/zil8k06j/production/ac5710872c7f703f0a4f7d887ad30a6dd280fcdd-1200x1600.webp","homeHero":"custom","name":"Under Armour","slug":"under-armour","videoFirst":false,"videoUrl":"https://vz-e818877b-c14.b-cdn.net/a6226ad6-724a-4beb-8923-f021bc92c1d0/play_480p.mp4#sanity=zil8k06j/production/5d99d34b3de3eea376a1b43e87679d5d3ed30081.mp4","gallery":[]},{"_id":"partnership.gatorade","brandLogoAlt":"Gatorade","brandLogoUrl":"https://cdn.sanity.io/images/zil8k06j/production/b779c0a86da7ba32d550b42cd4fd176112c3e704-3840x2160.png","category":"Beverage","description":"Long-running hydration partner, with Gatorade campaigns, sideline visibility, and a recurring slot in their game-day rotation.","externalLink":null,"heroImageAlt":"Justin Jefferson — Gatorade","heroImageUrl":"https://cdn.sanity.io/images/zil8k06j/production/6fa7c7fd07fdbf07119a115343881c3a9913963f-1067x1600.webp","homeHero":"custom","name":"Gatorade","slug":"gatorade","videoFirst":null,"videoUrl":null,"gallery":[]},{"_id":"partnership.pepsi","brandLogoAlt":"Pepsi","brandLogoUrl":"https://cdn.sanity.io/images/zil8k06j/production/75f4f38f87df8cf9c852346a428258da840cb8e8-900x898.png","category":"Beverage","description":"National Pepsi campaigns — suiting up in the gladiator arena alongside Megan Thee Stallion and crashing tailgates with Josh Allen.","externalLink":null,"heroImageAlt":"Justin Jefferson in the blue Pepsi jumpsuit","heroImageUrl":"https://cdn.sanity.io/images/zil8k06j/pro