5:[["$","$L1c",null,{"content":{"heroTitle":"Foundation","heroEyebrow":"Beyond the Game","heroIntro":"Off the field Justin enjoys giving back to the community that helped him get to where he is today. Actions speak louder than words.","heroPhotos":[{"src":"https://cdn.sanity.io/images/zil8k06j/production/4448877a0abc8237a07e2c80286620b94d3e8e9e-3648x5472.jpg","width":3648,"height":5472,"alt":"Justin Jefferson and a teammate handing out backpacks under the tent at the Backpack Drive","lqip":"data:image/jpeg;base64,"},{"src":"https://cdn.sanity.io/images/zil8k06j/production/24d2b1197f7f932b425c0c2a5b6a36b231d6010e-933x1400.webp","width":933,"height":1400,"alt":"A young camper at the JJets event","lqip":"data:image/jpeg;base64,"}],"manifestoLines":["BUILDING MINDSETS THAT","PERFORM AND CREATE","MEANINGFUL CHANGE"],"missionLogo":{"src":"https://cdn.sanity.io/images/zil8k06j/production/390d40e58dfc79a978ada67e933feb2f96d35fdc-9148x2442.png","alt":"The JJets Foundation","width":9148,"height":2442,"lqip":null},"collagePhotos":[{"src":"https://cdn.sanity.io/images/zil8k06j/production/93f87775461d60b7fdedadb318530e1d8b41a6ff-2682x3609.jpg","width":2682,"height":3609,"alt":"Justin with a young camper at the HardCount tent","lqip":"data:image/jpeg;base64,"},{"src":"https://cdn.sanity.io/images/zil8k06j/production/8adccb2114728d919049ef5551c6407569e298a9-3603x2669.jpg","width":3603,"height":2669,"alt":"Daps with a camper mid-field","lqip":"data:image/jpeg;base64,"},{"src":"https://cdn.sanity.io/images/zil8k06j/production/30abd2e2fe07a8090521954a225e4ae78343469b-3648x5472.jpg","width":3648,"height":5472,"alt":"Justin Jefferson with a young boy at the Backpack Drive","lqip":"data:image/jpeg;base64,"},{"src":"https://cdn.sanity.io/images/zil8k06j/production/5013d4bd26947015757bea8b6e1cb64563b274c8-7069x4844.jpg","width":7069,"height":4844,"alt":"The JJets Foundation Turkey Drive with volunteers and families","lqip":"data:image/jpeg;base64,"},{"src":"https://cdn.sanity.io/images/zil8k06j/production/6991299dd7a634b0e9b04b6428957a0dcacfda95-4807x3504.jpg","width":4807,"height":3504,"alt":"Chased down by the whole camp","lqip":"data:image/jpeg;base64,"},{"src":"https://cdn.sanity.io/images/zil8k06j/production/ededd88c64edf840333a45aa0caf7a510da96e13-3648x3082.jpg","width":3648,"height":3082,"alt":"Handing out backpacks under the tent at the Backpack Drive","lqip":"data:image/jpeg;base64,"},{"src":"https://cdn.sanity.io/images/zil8k06j/production/a3920af0eedbbcb5165cf1c43a29dff8da9e4ab7-4396x2564.jpg","width":4396,"height":2564,"alt":"The whole JJets camp on the field","lqip":"data:image/jpeg;base64,"},{"src":"https://cdn.sanity.io/images/zil8k06j/production/d4a9796253d68b1bbcfc63c46d32f4b47a2c64cb-4032x3024.jpg","width":4032,"height":3024,"alt":"Justin Jefferson and a teammate with kids at the Backpack Drive","lqip":"data:image/jpeg;base64,"}],"impactStats":[{"value":1443,"label":"Kids Impacted"},{"value":105,"label":"Money Raised","prefix":"$$","suffix":"K"},{"value":7,"label":"Schools Supported"}],"waysHeading":"WAYS YOU CAN HELP","tiers":[{"tier":"Tier 1","name":"Supporter","body":"Local businesses, family-owned companies, community partners, and startups.","range":"$$5,000 - $25,000","cta":{"label":"Learn more","href":"mailto:partnerships@jjettas.com?subject=Supporter%20Sponsorship%20Inquiry%20for%20"}},{"tier":"Tier 2","name":"Fan","body":"Regional businesses.","range":"$$50,000 - $100,000","cta":{"label":"Learn more","href":"mailto:partnerships@jjettas.com?subject=Fan%20Sponsorship%20Inquiry%20for%20"}},{"tier":"Tier 3","name":"Superstar","body":"National brands and Fortune 500 companies.","range":"$$250,000 +","cta":{"label":"Learn more","href":"mailto:partnerships@jjettas.com?subject=Superstar%20Sponsorship%20Inquiry%20for%20"}}],"footerCta":{"headline":["Bigger than","the game"],"cta":{"label":"Off-Field","href":"/off-field"},"cutout":{"src":"https://cdn.sanity.io/images/zil8k06j/production/8dd1e176f02b0ba66615f0fea2678b894a7788cf-1396x1600.webp","alt":"Justin Jefferson in a blue puffer jacket","width":1396,"height":1600,"lqip":null}}},"programs":[{"_id":"foundationProgram.1","title":"Justin Jefferson Football Camp","body":"Partnered with HardCount Athletics — 9 consecutive camps over 6 years, usually hosting 350 kids. Camps held in Minnesota at TCO Stadium, San Diego, Los Angeles, and Austin.","partner":"HardCount Athletics","cta":{"label":"Learn more","href":"/inquiries"},"media":[{"src":"https://cdn.sanity.io/images/zil8k06j/production/e177c323aa2aea94f56c13c01943f621088c41ec-1400x891.webp","width":1400,"height":891,"alt":"Justin celebrating with campers at the JJets Football Camp","lqip":"data:image/jpeg;base64,"},{"src":"https://cdn.sanity.io/images/zil8k06j/production/93f87775461d60b7fdedadb318530e1d8b41a6ff-2682x3609.jpg","width":2682,"height":3609,"alt":"Justin with a young camper at the HardCount tent","lqip":"data:image/jpeg;base64,"},{"src":"https://cdn.sanity.io/images/zil8k06j/production/8adccb2114728d919049ef5551c6407569e298a9-3603x2669.jpg","width":3603,"height":2669,"alt":"Daps with a camper mid-field","lqip":"data:image/jpeg;base64,"},{"src":"https://cdn.sanity.io/images/zil8k06j/production/5e50d8038cdc6a6fcea8e4753d919d0fb3b5c158-4950x3109.jpg","width":4950,"height":3109,"alt":"Laughing with campers between drills","lqip":"data:image/jpeg;base64,"},{"src":"https://cdn.sanity.io/images/zil8k06j/production/5c95590abca06fcea05d59d2ce98a67c6cb32e59-5343x3075.jpg","width":5343,"height":3075,"alt":"Justin running the camp line","lqip":"data:image/jpeg;base64,"},{"src":"https://cdn.sanity.io/images/zil8k06j/production/6991299dd7a634b0e9b04b6428957a0dcacfda95-4807x3504.jpg","width":4807,"height":3504,"alt":"Chased down by the whole camp","lqip":"data:image/jpeg;base64,"}]},{"_id":"foundationProgram.2","title":"Fashion Show","body":"Partnered with the Minnesota Vikings and M Health Fairview Masonic Children's Hospital — JJ hosted a Christmas fashion show with patient visits and free giveaways from Oakley, General Mills, Target, and Under Armour.","partner":"M Health Fairview Masonic Children's Hospital","cta":{"label":"Learn more","href":"/inquiries"},"media":[{"src":"https://cdn.sanity.io/images/zil8k06j/production/cd63ce8f6ce33e55ad8971595a6ea07293e3f244-960x1707.webp","width":960,"height":1707,"alt":"Justin Jefferson visiting M Health Fairview Masonic Children's Hospital","lqip":"data:image/jpeg;base64,","loopUrl":"https://vz-e818877b-c14.b-cdn.net/7ff87e55-6c72-473d-ac85-bdbddd7a2973/play_480p.mp4#sanity=zil8k06j/production/c8dd75565f372f7c71a20ba08a63d72eb7035095.mp4","playUrl":"https://vz-e818877b-c14.b-cdn.net/ee74dac5-2b32-4498-98bd-af42644e82a4/play_480p.mp4#sanity=zil8k06j/production/81d3d0f6c27bb5328e3fb83a821750e6b503c418.mp4"}]},{"_id":"foundationProgram.3","title":"Turkey Drive","body":"Partnered with United Health Care — donating turkeys and free groceries for the year to local community members.","partner":"United Health Care","cta":{"label":"Learn more","href":"/inquiries"},"media":[{"src":"https://cdn.sanity.io/images/zil8k06j/production/6c575444b48fe44b33c2dfe934feee8bdc35c8c0-7872x5038.jpg","width":7872,"height":5038,"alt":"Handing out turkeys at the community Turkey Drive","lqip":"data:image/jpeg;base64,","loopUrl":"https://cdn.sanity.io/files/zil8k06j/production/3ed50d6600429907fb7a83f202e8cad21033c79c.mp4","playUrl":"https://vz-e818877b-c14.b-cdn.net/5ffe8b47-d755-4471-a270-bd9f414e99ef/play_480p.mp4#sanity=zil8k06j/production/d0fd943e00b188dbf90ce21c67e1383fdda2d787.mp4"}]}]}],"$L1d"]
