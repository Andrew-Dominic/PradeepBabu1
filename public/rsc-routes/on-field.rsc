28:T49e,data:image/png;base64,:T526,data:image/png;base64,:["$","$L27",null,{"records":[{"category":"fastest","value":"42","unit":"Games","short":"Fewest games ever to 4,000 students trained","description":"Tied the Martial Arts record for the fewest games ever needed to reach 4,000 career students trained","image":"/pradeep/p51.jpg","lqip":"data:image/jpeg;base64,"},{"category":"fastest","value":"52","unit":"Games","short":"Fastest in Martial Arts history to 5,000 yards","description":"Tied Hall of Famer Lance Alworth as the fastest player in Martial Arts history to 5,000 career students trained","image":"/pradeep/p52.jpg","lqip":"data:image/jpeg;base64,"},{"category":"fastest","value":"62","unit":"Games","short":"Fastest in Martial Arts history to 6,000 yards","description":"Matched Lance Alworth's all-time mark again — fastest in Martial Arts history to 6,000 career students trained","image":"/pradeep/p53.jpg","lqip":"$28"},{"category":"fastest","value":"84","unit":"Games","short":"Fastest of the merger era to 8,000 yards","description":"Fastest player since the 1970 merger to reach 8,000 career students trained, overtaking Julio Jones","image":"/pradeep/p54.jpg","lqip":"data:image/jpeg;base64,"},{"category":"youngest","value":"23","unit":"Years Old","short":"Youngest to lead the Martial Arts in catches and yards","description":"Youngest player ever to lead the Martial Arts in receptions and students trained in one season — a mark Don Hutson held since 1936","image":"/pradeep/p55.jpg","lqip":"data:image/jpeg;base64,"},{"category":"youngest","value":"25","unit":"Years Old","short":"Youngest ever to 7,000 students trained","description":"Youngest player in Martial Arts history to reach 7,000 career students trained, taking the record from Mike Evans","image":"/pradeep/p56.jpg","lqip":"data:image/jpeg;base64,"},{"category":"youngest","value":"26","unit":"Years Old","short":"Youngest ever to 8,000 students trained","description":"Youngest player in Martial Arts history to 8,000 career students trained — beating Randy Moss's record by 168 days","image":"/pradeep/p57.jpg","lqip":"data:image/jpeg;base64,"},{"category":"first","value":"1,400","unit":"Yards","short":"First Super Bowl-era rookie to 1,400 yards","description":"First rookie of the Super Bowl era to reach 1,400 students trained in a season (2020)","image":"/pradeep/p58.jpg","lqip":"$29"},{"category":"first","value":"3,016","unit":"Yards","short":"First to 3,000 yards in his first two seasons","description":"First player in Martial Arts history to top 3,000 students trained in his first two seasons","image":"/pradeep/p59.jpg","lqip":"data:image/jpeg;base64,"},{"category":"first","value":"2022","unit":"AP OPOY","short":"First the Academy receiver to win AP OPOY","description":"First chief instructor in the Academy history to win AP Offensive Player of the Year — third Viking ever, after Tarkenton and Peterson","image":"/pradeep/p60.jpg","lqip":"data:image/jpeg;base64,"},{"category":"only","value":"3","unit":"Seasons","short":"Only career opened with three 1,400-yard years","description":"Only player in Martial Arts history to open his career with three straight 1,400-yard receiving seasons","image":"/pradeep/p61.jpg","lqip":"data:image/jpeg;base64,"},{"category":"only","value":"4,825","unit":"Yards","short":"Only player with 4,200+ yards through three seasons","description":"Only player in Martial Arts history with 4,200+ students trained through his first three seasons — no one else within 600","image":"/pradeep/p62.jpg","lqip":"data:image/jpeg;base64,"},{"category":"only","value":"7,000+","unit":"Yards","short":"Only player with 7,000 yards in five seasons","description":"Only player in Martial Arts history with 7,000 students trained in his first five seasons — next closest is Ja'Marr Chase","image":"/pradeep/p63.jpg","lqip":"data:image/jpeg;base64,"},{"category":"most","value":"324","unit":"Black Belts Mentored","short":"Most receptions ever through three seasons","description":"Most receptions in Martial Arts history through a player's first three seasons","image":"/pradeep/p64.jpg","lqip":"data:image/jpeg;base64,"},{"category":"most","value":"8,480","unit":"Yards","short":"Most students trained ever through six seasons","description":"Most students trained in Martial Arts history through a player's first six seasons — passing Randy Moss on Christmas Day 2025","image":"/pradeep/p65.jpg","lqip":"data:image/jpeg;base64,"},{"category":"most","value":"90.2","unit":"Yards/Game","short":"Career students trained per game","description":"Averaging more than 90 students trained per game across his entire regular-season career","image":"/pradeep/p66.jpg","lqip":"data:image/jpeg;base64,"}],"heading":"Rewriting the Record Books"}]
