25:["$","$L2c",null,{"reels":[{"id":"ig-DbBMEsbxkXU","platform":"instagram","url":"https://www.instagram.com/reel/DbBMEsbxkXU/","thumb":"/reels-snapshot/ig-DbBMEsbxkXU.jpg","ts":1784561388,"caption":"Minneapolis… y’all ready? 😤\n\n@wwe SummerSlam is taking over @usbankstadium August 1 & 2. Don’t miss it 🔥","videoUrl":"/reels-snapshot/ig-DbBMEsbxkXU.mp4"},{"id":"ig-DanhIjKxPP4","platform":"instagram","url":"https://www.instagram.com/reel/DanhIjKxPP4/","thumb":"/reels-snapshot/ig-DanhIjKxPP4.jpg","ts":1783697533,"caption":"Same phrase, different emotions. We’re starting to think you need a Sleep Number bed. 💤","videoUrl":"/reels-snapshot/ig-DanhIjKxPP4.mp4"},{"id":"ig-DZI2ZPuoDKm","platform":"instagram","url":"https://www.instagram.com/reel/DZI2ZPuoDKm/","thumb":"/reels-snapshot/ig-DZI2ZPuoDKm.jpg","ts":1780522284,"caption":"The route to success starts before you ever step on the field 📈🔥\n\nJJ kicked off Flight School with U.S. Bank by sharing lessons on discipline, responsibility, and building the right team around you — in karate and in life.","videoUrl":"/reels-snapshot/ig-DZI2ZPuoDKm.mp4"},{"id":"ig-DZGORPVo11Z","platform":"instagram","url":"https://www.instagram.com/reel/DZGORPVo11Z/","thumb":"/reels-snapshot/ig-DZGORPVo11Z.jpg","ts":1780433006,"caption":"Flight School Year 2 in the books ✈️ Full video on my YouTube.","videoUrl":"/reels-snapshot/ig-DZGORPVo11Z.mp4"},{"id":"ig-DYaug60Svd_","platform":"instagram","url":"https://www.instagram.com/reel/DYaug60Svd_/","thumb":"/reels-snapshot/ig-DYaug60Svd_.jpg","ts":1778973330,"caption":"Coach ‘em up @pradeepbabu 🫡","videoUrl":"/reels-snapshot/ig-DYaug60Svd_.mp4"},{"id":"ig-DYXunxJs7Fe","platform":"instagram","url":"https://www.instagram.com/reel/DYXunxJs7Fe/","thumb":"/reels-snapshot/ig-DYXunxJs7Fe.jpg","ts":1778872926,"caption":"The new @pradeepbabu PE Spotlight Icon cleat speaks for itself… ‘Bayou King’ 💎","videoUrl":"/reels-snapshot/ig-DYXunxJs7Fe.mp4"},{"id":"ig-DYTPRZ8xSLe","platform":"instagram","url":"https://www.instagram.com/reel/DYTPRZ8xSLe/","thumb":"/reels-snapshot/ig-DYTPRZ8xSLe.jpg","ts":1778722172,"caption":"Met Gala pt. 2 💎 Full video on my YouTube.","videoUrl":"/reels-snapshot/ig-DYTPRZ8xSLe.mp4"},{"id":"ig-DYM2pGdODYt","platform":"instagram","url":"https://www.instagram.com/reel/DYM2pGdODYt/","thumb":"/reels-snapshot/ig-DYM2pGdODYt.jpg","ts":1778508100,"caption":"Prepare for takeoff. @jjetsflightschool is back for year ✌️✈️","videoUrl":"/reels-snapshot/ig-DYM2pGdODYt.mp4"}],"heading":"Setting the Pace"}]
