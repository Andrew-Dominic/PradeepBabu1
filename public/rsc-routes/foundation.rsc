5:[["$","$L1c",null,{"content":{"heroTitle":"Academy","heroEyebrow":"Beyond the Game","heroIntro":"Off the field Pradeep enjoys giving back to the community that helped him get to where he is today. Actions speak louder than words.","heroPhotos":[{"src":"/pradeep/p05.jpg","width":3648,"height":5472,"alt":"M. Pradeep Babu and a teammate handing out backpacks under the tent at the Backpack Drive","lqip":"data:image/jpeg;base64,"},{"src":"/pradeep/p06.jpg","width":933,"height":1400,"alt":"A young camper at the Zen Karate Academy event","lqip":"data:image/jpeg;base64,"}],"manifestoLines":["BUILDING MINDSETS THAT","PERFORM AND CREATE","MEANINGFUL CHANGE"],"missionLogo":{"src":"/sanity/images/390d40e58dfc79a978ada67e933feb2f96d35fdc-9148x2442.png","alt":"The Zen Karate Academy Academy","width":9148,"height":2442,"lqip":null},"collagePhotos":[{"src":"/pradeep/p07.jpg","width":2682,"height":3609,"alt":"Pradeep with a young camper at the HardCount tent","lqip":"data:image/jpeg;base64,"},{"src":"/pradeep/p08.jpg","width":3603,"height":2669,"alt":"Daps with a camper mid-field","lqip":"data:image/jpeg;base64,"},{"src":"/pradeep/p09.jpg","width":3648,"height":5472,"alt":"M. Pradeep Babu with a young boy at the Backpack Drive","lqip":"data:image/jpeg;base64,"},{"src":"/pradeep/p10.jpg","width":7069,"height":4844,"alt":"The Zen Karate Academy Academy Youth Self-Defense & Outreach with volunteers and families","lqip":"data:image/jpeg;base64,"},{"src":"/pradeep/p11.jpg","width":4807,"height":3504,"alt":"Chased down by the whole camp","lqip":"data:image/jpeg;base64,"},{"src":"/pradeep/p12.jpg","width":3648,"height":3082,"alt":"Handing out backpacks under the tent at the Backpack Drive","lqip":"data:image/jpeg;base64,"},{"src":"/pradeep/p13.jpg","width":4396,"height":2564,"alt":"The whole Zen Karate Academy camp on the field","lqip":"data:image/jpeg;base64,"},{"src":"/pradeep/p14.jpg","width":4032,"height":3024,"alt":"M. Pradeep Babu and a teammate with kids at the Backpack Drive","lqip":"data:image/jpeg;base64,"}],"impactStats":[{"value":1700,"label":"Students Trained"},{"value":150,"label":"Black Belts Produced","prefix":"$$","suffix":"K"},{"value":7,"label":"Years of Excellence"}],"waysHeading":"WAYS YOU CAN HELP","tiers":[{"tier":"Tier 1","name":"Supporter","body":"Local businesses, family-owned companies, community partners, and startups.","range":"$$5,000 - $25,000","cta":{"label":"Learn more","href":"mailto:partnerships@pradeepbabu.com?subject=Supporter%20Sponsorship%20Inquiry%20for%20"}},{"tier":"Tier 2","name":"Fan","body":"Regional businesses.","range":"$$50,000 - $100,000","cta":{"label":"Learn more","href":"mailto:partnerships@pradeepbabu.com?subject=Fan%20Sponsorship%20Inquiry%20for%20"}},{"tier":"Tier 3","name":"Superstar","body":"National brands and Fortune 500 companies.","range":"$$250,000 +","cta":{"label":"Learn more","href":"mailto:partnerships@pradeepbabu.com?subject=Superstar%20Sponsorship%20Inquiry%20for%20"}}],"footerCta":{"headline":["Bigger than","the game"],"cta":{"label":"Life","href":"/off-field"},"cutout":{"src":"/pradeep/p15.jpg","alt":"M. Pradeep Babu in a blue puffer jacket","width":1396,"height":1600,"lqip":null}}},"programs":[{"_id":"foundationProgram.1","title":"Zen Isshinryu Karate Academy","body":"Partnered with Zen Isshinryu Karate — 9 consecutive camps over 6 years, usually hosting 350 kids. Camps held in Minnesota at TCO Stadium, San Diego, Los Angeles, and Austin.","partner":"Zen Isshinryu Karate","cta":{"label":"Learn more","href":"/inquiries"},"media":[{"src":"/pradeep/p16.jpg","width":1400,"height":891,"alt":"Pradeep celebrating with campers at the Zen Karate Academy Karate Camp","lqip":"data:image/jpeg;base64,"},{"src":"/pradeep/p17.jpg","width":2682,"height":3609,"alt":"Pradeep with a young camper at the HardCount tent","lqip":"data:image/jpeg;base64,"},{"src":"/pradeep/p18.jpg","width":3603,"height":2669,"alt":"Daps with a camper mid-field","lqip":"data:image/jpeg;base64,"},{"src":"/pradeep/p19.jpg","width":4950,"height":3109,"alt":"Laughing with campers between drills","lqip":"data:image/jpeg;base64,"},{"src":"/pradeep/p20.jpg","width":5343,"height":3075,"alt":"Pradeep running the camp line","lqip":"data:image/jpeg;base64,"},{"src":"/pradeep/p21.jpg","width":4807,"height":3504,"alt":"Chased down by the whole camp","lqip":"data:image/jpeg;base64,"}]},{"_id":"foundationProgram.2","title":"World Record & Endurance Feats","body":"Partnered with the Zen Isshinryu Karate and M Health Fairview Masonic Children's Hospital — JJ hosted a Christmas fashion show with patient visits and free giveaways from Oakley, General Mills, Target, and Under Armour.","partner":"M Health Fairview Masonic Children's Hospital","cta":{"label":"Learn more","href":"/inquiries"},"media":[{"src":"/pradeep/p22.jpg","width":960,"height":1707,"alt":"M. Pradeep Babu visiting M Health Fairview Masonic Children's Hospital","lqip":"data:image/jpeg;base64,","loopUrl":"https://vz-e818877b-c14.b-cdn.net/7ff87e55-6c72-473d-ac85-bdbddd7a2973/play_480p.mp4#sanity=zil8k06j/production/c8dd75565f372f7c71a20ba08a63d72eb7035095.mp4","playUrl":"https://vz-e818877b-c14.b-cdn.net/ee74dac5-2b32-4498-98bd-af42644e82a4/play_480p.mp4#sanity=zil8k06j/production/81d3d0f6c27bb5328e3fb83a821750e6b503c418.mp4"}]},{"_id":"foundationProgram.3","title":"Youth Self-Defense & Outreach","body":"Partnered with Community & Educational Outreach — donating turkeys and free groceries for the year to local community members.","partner":"Community & Educational Outreach","cta":{"label":"Learn more","href":"/inquiries"},"media":[{"src":"/pradeep/p23.jpg","width":7872,"height":5038,"alt":"Handing out turkeys at the community Youth Self-Defense & Outreach","lqip":"data:image/jpeg;base64,","loopUrl":"https://cdn.sanity.io/files/zil8k06j/production/3ed50d6600429907fb7a83f202e8cad21033c79c.mp4","playUrl":"https://vz-e818877b-c14.b-cdn.net/5ffe8b47-d755-4471-a270-bd9f414e99ef/play_480p.mp4#sanity=zil8k06j/production/d0fd943e00b188dbf90ce21c67e1383fdda2d787.mp4"}]}]}],"$L1d"]
